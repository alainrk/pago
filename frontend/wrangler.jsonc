// Cloudflare Workers static assets config for the frontend.
// `npm run deploy` builds the app and uploads dist/ as static assets.
//
// This file is intentionally generic. Attach your own custom domain in the
// Cloudflare dashboard (Workers & Pages > pago-web > Settings > Domains & Routes)
// or via a local, untracked copy passed with `wrangler deploy --config`.
{
  "name": "pago-web",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // The old address, pago.alaindichiappari.dev, belongs to the redirect
  // Worker in redirect/.
  "routes": [
    { "pattern": "pago.faccio.app", "custom_domain": true }
  ]
}
