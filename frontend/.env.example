# Copy to .env.production.local (used by `npm run build` / `npm run deploy`)
# or .env.local (used by `npm run dev`).
#
# Base URL of the Pago API server (the Go web server), without trailing slash.
# Leave empty in development: the Vite dev server proxies /web to localhost:8091.
VITE_API_URL=

# Optional. Only needed when one build serves more than one hostname, for
# example while the app moves to a new domain. See src/lib/domains.ts.
#
# API origin per page host ("host=url", comma separated). The app and the API
# must share a parent domain for the session cookie, so the old app host keeps
# the old API host.
# VITE_API_URL_BY_HOST=app.old.example=https://api.old.example
#
# Hosts that show a "we moved" banner, and where the banner sends people.
# VITE_MOVED_FROM_HOSTS=app.old.example
# VITE_MOVED_TO_URL=https://app.new.example
# Optional date shown in the banner ("Please switch before ...").
# VITE_MOVED_BY_DATE=1 March
