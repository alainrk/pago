# Build stage
FROM golang:1.26-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the source code
COPY . .

# Build the web server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o pago-web \
    ./cmd/web/main.go

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 -S pago && \
    adduser -u 1000 -S pago -G pago

# Set working directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/pago-web /app/pago-web

# Copy web assets (templates and static files)
COPY web/ ./web/

# Change ownership
RUN chown -R pago:pago /app

# Switch to non-root user
USER pago

# Expose port 8081 (web)
EXPOSE 8081

# Set entrypoint
ENTRYPOINT ["/app/pago-web"]
